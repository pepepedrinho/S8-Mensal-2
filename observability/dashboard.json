{
  "displayName": "Triodelicia - Observabilidade",
  "mosaicLayout": {
    "columns": 12,
    "tiles": [
      {
        "xPos": 0, "yPos": 0, "width": 6, "height": 4,
        "widget": {
          "title": "1. Disponibilidade (uptime check HTTPS)",
          "xyChart": {
            "dataSets": [{
              "timeSeriesQuery": {
                "timeSeriesFilter": {
                  "filter": "metric.type=\"monitoring.googleapis.com/uptime_check/check_passed\" AND resource.type=\"uptime_url\"",
                  "aggregation": { "alignmentPeriod": "300s", "perSeriesAligner": "ALIGN_FRACTION_TRUE" }
                }
              },
              "plotType": "LINE"
            }],
            "yAxis": { "label": "fracao de sucesso", "scale": "LINEAR" }
          }
        }
      },
      {
        "xPos": 6, "yPos": 0, "width": 6, "height": 4,
        "widget": {
          "title": "2. Desempenho (latencia HTTP p50/p95/p99 por rota)",
          "xyChart": {
            "dataSets": [
              {
                "legendTemplate": "p50",
                "timeSeriesQuery": { "timeSeriesFilter": {
                  "filter": "metric.type=\"logging.googleapis.com/user/triodelicia_request_latency_ms\"",
                  "aggregation": { "alignmentPeriod": "60s", "perSeriesAligner": "ALIGN_PERCENTILE_50" }
                }},
                "plotType": "LINE"
              },
              {
                "legendTemplate": "p95",
                "timeSeriesQuery": { "timeSeriesFilter": {
                  "filter": "metric.type=\"logging.googleapis.com/user/triodelicia_request_latency_ms\"",
                  "aggregation": { "alignmentPeriod": "60s", "perSeriesAligner": "ALIGN_PERCENTILE_95" }
                }},
                "plotType": "LINE"
              },
              {
                "legendTemplate": "p99",
                "timeSeriesQuery": { "timeSeriesFilter": {
                  "filter": "metric.type=\"logging.googleapis.com/user/triodelicia_request_latency_ms\"",
                  "aggregation": { "alignmentPeriod": "60s", "perSeriesAligner": "ALIGN_PERCENTILE_99" }
                }},
                "plotType": "LINE"
              }
            ],
            "yAxis": { "label": "ms", "scale": "LINEAR" }
          }
        }
      },
      {
        "xPos": 0, "yPos": 4, "width": 6, "height": 4,
        "widget": {
          "title": "3. Erros (taxa de 5xx vs total de requisicoes)",
          "xyChart": {
            "dataSets": [
              {
                "legendTemplate": "erros 5xx/s",
                "timeSeriesQuery": { "timeSeriesFilter": {
                  "filter": "metric.type=\"logging.googleapis.com/user/triodelicia_error_count\"",
                  "aggregation": { "alignmentPeriod": "60s", "perSeriesAligner": "ALIGN_RATE" }
                }},
                "plotType": "LINE"
              },
              {
                "legendTemplate": "total req/s",
                "timeSeriesQuery": { "timeSeriesFilter": {
                  "filter": "metric.type=\"logging.googleapis.com/user/triodelicia_request_count\"",
                  "aggregation": { "alignmentPeriod": "60s", "perSeriesAligner": "ALIGN_RATE" }
                }},
                "plotType": "LINE"
              }
            ],
            "yAxis": { "label": "req/s", "scale": "LINEAR" }
          }
        }
      },
      {
        "xPos": 6, "yPos": 4, "width": 6, "height": 4,
        "widget": {
          "title": "4. Banco de dados (operacoes por sucesso/falha)",
          "xyChart": {
            "dataSets": [{
              "timeSeriesQuery": { "timeSeriesFilter": {
                "filter": "metric.type=\"logging.googleapis.com/user/triodelicia_db_operation_count\"",
                "aggregation": {
                  "alignmentPeriod": "60s",
                  "perSeriesAligner": "ALIGN_RATE",
                  "crossSeriesReducer": "REDUCE_SUM",
                  "groupByFields": ["metric.label.success", "metric.label.operation"]
                }
              }},
              "plotType": "STACKED_BAR"
            }],
            "yAxis": { "label": "ops/s", "scale": "LINEAR" }
          }
        }
      },
      {
        "xPos": 0, "yPos": 8, "width": 6, "height": 4,
        "widget": {
          "title": "5. Redundancia (requisicoes por frontend Cloud Run)",
          "xyChart": {
            "dataSets": [{
              "timeSeriesQuery": { "timeSeriesFilter": {
                "filter": "metric.type=\"run.googleapis.com/request_count\" AND resource.type=\"cloud_run_revision\" AND (resource.label.service_name=\"triodelicia-frontend-sae1\" OR resource.label.service_name=\"triodelicia-frontend-saw1\")",
                "aggregation": {
                  "alignmentPeriod": "60s",
                  "perSeriesAligner": "ALIGN_RATE",
                  "crossSeriesReducer": "REDUCE_SUM",
                  "groupByFields": ["resource.label.service_name"]
                }
              }},
              "plotType": "LINE"
            }],
            "yAxis": { "label": "req/s", "scale": "LINEAR" }
          }
        }
      },
      {
        "xPos": 6, "yPos": 8, "width": 6, "height": 4,
        "widget": {
          "title": "6. Uso da aplicacao (eventos de negocio por tipo)",
          "xyChart": {
            "dataSets": [{
              "timeSeriesQuery": { "timeSeriesFilter": {
                "filter": "metric.type=\"logging.googleapis.com/user/triodelicia_usage_event_count\"",
                "aggregation": {
                  "alignmentPeriod": "60s",
                  "perSeriesAligner": "ALIGN_RATE",
                  "crossSeriesReducer": "REDUCE_SUM",
                  "groupByFields": ["metric.label.event"]
                }
              }},
              "plotType": "STACKED_BAR"
            }],
            "yAxis": { "label": "eventos/s", "scale": "LINEAR" }
          }
        }
      }
    ]
  }
}
